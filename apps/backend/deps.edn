{:paths ["src" "resources"]
 ;; versões ILUSTRATIVAS — fixar no setup real
 :deps {org.clojure/clojure                     {:mvn/version "1.12.0"}
        io.pedestal/pedestal.service            {:mvn/version "0.7.2"}
        io.pedestal/pedestal.jetty              {:mvn/version "0.7.2"}
        com.stuartsierra/component              {:mvn/version "1.1.0"}
        com.github.seancorfield/next.jdbc       {:mvn/version "1.3.955"}
        com.github.seancorfield/honeysql        {:mvn/version "2.6.1230"}
        com.zaxxer/HikariCP                     {:mvn/version "5.1.0"}
        org.postgresql/postgresql               {:mvn/version "42.7.4"}
        metosin/malli                           {:mvn/version "0.16.4"}
        metosin/jsonista                        {:mvn/version "0.3.10"}
        migratus/migratus                       {:mvn/version "1.5.4"}
        org.clojure/tools.logging               {:mvn/version "1.3.0"}   ; fachada de logging (-> SLF4J -> logback)
        ch.qos.logback/logback-classic          {:mvn/version "1.5.6"}   ; backend SLF4J — logging real (Inv.7); mata o warning NOP
        io.minio/minio                          {:mvn/version "8.5.12"}  ; client S3 (object storage S3-compativel, §22.9)
        com.taoensso/carmine                    {:mvn/version "3.4.1"}   ; client Redis-protocol (Valkey)
        com.auth0/java-jwt                      {:mvn/version "4.4.0"}   ; verificacao JWT RS256 (Onda D Slice 1)
        com.auth0/jwks-rsa                       {:mvn/version "0.22.1"}  ; JWKS cache+rate-limit por-issuer
        ;; PRIMEIRA dependencia JVM de renderizacao do repo (Etapa 5 fatia 3 — o PDF da folha de presenca).
        ;; Versao resolvida de fato contra o Maven Central em 15/08/2026 (`clojure -Stree` com
        ;; `{:mvn/version "RELEASE"}`), nao chutada — traz transitivamente org.apache.pdfbox/pdfbox 3.0.7.
        ;; LICENCA: openhtmltopdf e' LGPL 2.1+ (github.com/danfickle/openhtmltopdf). O Plenario e' SaaS —
        ;; nao distribui o jar a terceiros — logo e' CONFORME sem obrigacao de relink dinamico. CARRY: se a
        ;; Casa vier a rodar a plataforma on-prem (fora do SaaS), isso VIRA distribuicao e a LGPL passa a
        ;; exigir relink (jar dinamico, nao shade/AOT estatico) — decisao a revisitar se/quando existir.
        io.github.openhtmltopdf/openhtmltopdf-pdfbox {:mvn/version "1.1.73"}}
 :aliases
 {:dev  {:extra-paths ["dev" "test"]}
  ;; os dirs de suite SAO raizes de classpath (ns oplenario.* sob test/unit, nao test/unit.oplenario.*);
  ;; alinhado ao tests.edn p/ o REPL carregar tambem, nao so o kaocha (que adiciona test-paths dinamicamente).
  :test {:extra-paths ["test/unit" "test/integration" "test/e2e" "test/keycloak"]
         :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                       clj-kondo/clj-kondo {:mvn/version "2026.05.25"}} ; analise p/ o import-lint (§22.10)
         :main-opts   ["-m" "kaocha.runner"]}
  :build {:deps      {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}}}
