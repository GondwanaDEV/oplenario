{:env    nil                          ; "dev"|"test"|"production"|"staging" — SEMPRE do ambiente (APP_ENV); sem default.
                                      ; So' dev/test ligam o idp-dev (que confia em JWT NAO-ASSINADO); QUALQUER outro
                                      ; valor — inclusive AUSENTE ("" ou nil, que e' este default) — usa o KeycloakIdp
                                      ; real. O modo dev e' opt-in EXPLICITO (docker-compose seta APP_ENV).
                                      ; Este default era "dev", e o "fail-safe" de `sistema/idp-para` (§ um :env
                                      ; desconhecido cai no IdP real) NAO protegia contra isso: quem deployasse sem
                                      ; setar APP_ENV nao chegava em idp-para com um valor desconhecido — chegava com
                                      ; "dev" na mao, e todo `exige-papel` desabava (claims forjaveis, cross-tenant
                                      ; inclusive). Fail-safe de verdade = ausencia tambem falha p/ o lado seguro.
 :http   {:port 8888}
 :db     {:jdbc-url "jdbc:postgresql://localhost:5432/oplenario" :user "oplenario" :password "dev"
          :pool-max-size 10} ; dimensionar contra max_connections do PG / nº de réplicas (deploy)
 :valkey {:uri "redis://localhost:6379"}
 ;; backplane do tempo real (§22.6 eixo G): :memoria (1 no / dev / teste) | :valkey (multi-no / prod).
 ;; Override por TEMPO_REAL_BACKPLANE. Prod multi-replica DEVE usar :valkey (a impl em memoria nao compartilha
 ;; canal entre replicas; cada uma so veria os eventos que ela mesma drenou).
 :tempo-real {:backplane :memoria}
 :objeto-store {:endpoint "http://localhost:9000" :access-key "oplenario" :secret-key "dev12345" :bucket "oplenario"}
 ;; :base-url e' o backend-interno (falado entre containers docker); :base-url-publico e' o BROWSER-facing
 ;; (dev KC --profile auth mapeia p/ o host porta 8090) — GET /auth/descoberta/:ente devolve o publico, nunca
 ;; o interno (o browser nao resolve "keycloak" via docker DNS). :web-client-id/:redirect-uris/:web-origins =
 ;; superficie de config do client publico PKCE (Onda D Slice 2; provisionamento = Task 7).
 :keycloak {:base-url "http://localhost:8080" :base-url-publico "http://localhost:8090"
            :realm-prefixo "ente-" :audiencia "oplenario-backend"
            :admin-usuario "admin" :admin-senha "admin" :jwks-cache-ttl-s 600
            :web-client-id "oplenario-web"
            :redirect-uris ["http://localhost:3000/api/auth/callback"]
            :web-origins ["http://localhost:3000"]
            ;; Onda D Slice 5 Task 2: p/ onde o realm provisionado aponta o smtpServer -- quem ENVIA o
            ;; convite/e-mails de uso-unico e' o proprio Keycloak (config de realm), nao a app (nao
            ;; confundir com o carry F6 do e-mail TRANSACIONAL da app). Mailpit em dev/test.
            :smtp {:host "mailpit" :port 1025 :from "nao-responda@oplenario.local"
                   :ssl false :starttls false :auth false}}
 ;; Onda D Slice 2 Task 4: teto absoluto + janela de ociosidade da sessao opaca (POST /auth/sessoes mint).
 ;; CARRY: `:ociosa-min` 30 == 1800s = o default HARDCODED `sessao-janela-ociosa-seg` do Repo de identidade
 ;; (oplenario.identidade.components.repositorio) — sao HOJE duas fontes do MESMO numero que so' concordam
 ;; por convencao (o mint crava o `ocioso-ate` inicial a partir DAQUI; o Repo desliza a MESMA janela em cada
 ;; resolve a partir do SEU proprio default). Mudar um sem o outro dessincroniza; reconciliar fazendo o Repo
 ;; ler este valor em vez de ter default proprio.
 :sessao {:absoluta-h 12 :ociosa-min 30}
 ;; URL por modulo p/ os http_client (local agora, remoto apos extracao — §22.10)
 :modulos {:cadastros {:base-url "http://localhost:8888"} :identidade {:base-url "http://localhost:8888"}
           :legislativo {:base-url "http://localhost:8888"} :sessoes {:base-url "http://localhost:8888"}
           :transparencia {:base-url "http://localhost:8888"} :participacao {:base-url "http://localhost:8888"}
           :compliance {:base-url "http://localhost:8888"}}}
