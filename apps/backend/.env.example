# Portas do host p/ a stack local (docker-compose.yml). Copie p/ .env e ajuste se houver conflito
# com outras stacks locais. docker compose le o .env automaticamente. Defaults = portas padrao.
OPLENARIO_PG_PORT=5432
OPLENARIO_VALKEY_PORT=6379
# Senha do Valkey local (`requirepass`) — valor SO' de desenvolvimento, nunca o de producao. O compose passa a mesma
# senha ao backend (VALKEY_PASSWORD). Vazia/ausente = Valkey sem senha (aceito so' com APP_ENV dev/test). Quem roda a
# suite contra um Valkey com senha passa `-e VALKEY_PASSWORD=...` ao container de teste.
OPLENARIO_VALKEY_PASSWORD=dev-valkey-local
OPLENARIO_MINIO_PORT=9000
OPLENARIO_MINIO_CONSOLE_PORT=9001
OPLENARIO_KEYCLOAK_PORT=8080
OPLENARIO_MAILPIT_PORT=8025
OPLENARIO_SMTP_PORT=1025
OPLENARIO_APP_PORT=8888
OPLENARIO_FRONTEND_PORT=3000
